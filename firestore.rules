rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'yunuen.0910@gmail.com' ||
        request.auth.token.email == 'admin@aulagrade.edu'
      );
    }

    function isTeacherOrAdmin() {
      return isSignedIn();
    }

    // Public test document for connectivity verification
    match /test/connection {
      allow read, write: if true;
    }

    // Schools / Planteles: Readable by authenticated members, editable by admins
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if isBootstrappedAdmin() || isSignedIn() || resource == null;
    }

    // Users (Teachers & Admins)
    match /users/{userId} {
      allow read: if true;
      allow write: if isBootstrappedAdmin() || isSignedIn() || resource == null;
    }

    // Academic Cycles
    match /cycles/{cycleId} {
      allow read: if true;
      allow write: if isBootstrappedAdmin() || isSignedIn() || resource == null;
    }

    // Groups & Classes
    match /groups/{groupId} {
      allow read: if true;
      allow write: if isBootstrappedAdmin() || isSignedIn() || resource == null;
    }

    // Assignments
    match /assignments/{assignmentId} {
      allow read: if true;
      allow write: if isBootstrappedAdmin() || isSignedIn() || resource == null;
    }

    // Student Scores
    match /scores/{groupId} {
      allow read: if true;
      allow write: if isBootstrappedAdmin() || isSignedIn() || resource == null;
    }
  }
}
